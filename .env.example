# ── Обязательные ──────────────────────────────────────────────
# Подключение к PostgreSQL (на Railway подставляется из сервиса Postgres: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kazkompozit"
# Секрет подписи сессий админки — случайная строка не короче 32 символов
AUTH_SECRET="замените-на-длинную-случайную-строку-минимум-32-символа"
# Адрес сайта без слэша в конце (для SEO, sitemap, ссылок)
SITE_URL="http://localhost:3000"
# test — показывать демо-цены с пометкой; production — только утверждённые цены
APP_MODE="test"

# Первый администратор (создаётся при первом запуске, если такого e-mail ещё нет)
ADMIN_EMAIL="admin@kazkompozit.kz"
ADMIN_PASSWORD="задайте-надёжный-пароль"

# ── Хранилище файлов (необязательно) ──────────────────────────
# Без S3 файлы пишутся в папку STORAGE_DIR (на Railway подключите том к /app/storage)
STORAGE_DIR="./storage"
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Уведомления о заявках в Telegram (необязательно) ──────────
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# ── WhatsApp Business Platform (необязательно) ────────────────
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""

# ── Языковая модель для ИИ-агентов (необязательно) ────────────
# LLM_PROVIDER="anthropic"        # или openai-compatible
# LLM_API_KEY=""
# LLM_MODEL=""
# LLM_BASE_URL=""                 # только для openai-compatible
